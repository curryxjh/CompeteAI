# CompeteAI 环境变量示例
# 复制为 .env 并填入真实值（.env 已加入 .gitignore，不会提交）
#
# 优先级：环境变量 > .env > config/dev.local.yaml > config/dev.yaml
# 所有变量均为可选，未设置时使用 config/dev.yaml 中的默认值

# ── LLM / Embedding API ──────────────────────────────────────────
ARK_API_KEY=<YOUR_ARK_API_KEY>
VOLCANO_EMBED_API_KEY=<YOUR_VOLCANO_EMBED_API_KEY>

# ── MySQL ─────────────────────────────────────────────────────────
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=<YOUR_MYSQL_PASSWORD>
# MYSQL_DB=compete_ai

# ── Redis ─────────────────────────────────────────────────────────
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Milvus ────────────────────────────────────────────────────────
# MILVUS_ADDRESS=127.0.0.1:19530
# 或分开设置：
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530

# ── Docker Compose 专用 ──────────────────────────────────────────
# MYSQL_ROOT_PASSWORD=<YOUR_MYSQL_ROOT_PASSWORD>
# MINIO_ACCESS_KEY=<YOUR_MINIO_ACCESS_KEY>
# MINIO_SECRET_KEY=<YOUR_MINIO_SECRET_KEY>

# ── 配置文件路径（不指定时默认 config/dev.yaml）─────────────────
# CONFIG_FILE=config/dev.yaml