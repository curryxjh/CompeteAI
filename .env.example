# CompeteAI 环境变量示例
# 复制为 .env 并填入真实值（.env 已加入 .gitignore，不会提交）
#
# 优先级：.env > config/dev.yaml
# 所有变量均为可选，未设置时使用 config/dev.yaml 中的默认值

# ── LLM / Embedding API ──────────────────────────────────────────
ARK_API_KEY=your_ark_api_key_here
VOLCANO_EMBED_API_KEY=your_volcano_embed_key_here

# ── MySQL ─────────────────────────────────────────────────────────
# MYSQL_HOST=*.*.*.*
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=*******
# MYSQL_DB=compete_ai

# ── Redis ─────────────────────────────────────────────────────────
# REDIS_HOST=122.51.191.166
# REDIS_PORT=26379
# REDIS_PASSWORD=

# ── Milvus ────────────────────────────────────────────────────────
# MILVUS_ADDRESS=122.51.191.166:19530
# 或分开设置：
# MILVUS_HOST=122.51.191.166
# MILVUS_PORT=19530

# ── 配置文件路径（不指定时默认 config/dev.yaml）─────────────────
# CONFIG_FILE=config/dev.yaml
